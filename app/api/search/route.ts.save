// ============================================================
// 網址標準化
// ============================================================

function normalizeUrl(url: string) {

    try {

        let value = url.trim();

        if (!/^https?:\/\//i.test(value)) {
            value = `https://${value}`;
        }

        const parsed = new URL(value);

        return (
            parsed.protocol +
            "//" +
            parsed.hostname
        );

    } catch {

        return url;

    }
}

// ============================================================
// 網域
// ============================================================

function getDomain(url: string) {

    try {

        return new URL(url)
            .hostname
            .replace(/^www\./, "")
            .toLowerCase();

    } catch {

        return "";

    }
}

// ============================================================
// 排除網站
// ============================================================

function isExcludedDomain(url: string) {

    const domain =
        getDomain(url);

    return excludedDomains.some(
        excluded =>
            domain === excluded ||
            domain.endsWith(
                "." + excluded
            )
    );
}

// ============================================================
// 排除關鍵字
// ============================================================

function hasExcludedKeyword(
    title: string,
    description: string,
    url: string
) {

    const text =
        `${title} ${description} ${url}`
            .toLowerCase();

    return excludedKeywords.some(
        keyword =>
            text.includes(
                keyword.toLowerCase()
            )
    );
}

// ============================================================
// 清理文字
// ============================================================

function cleanText(
    text: string
) {

    return String(text || "")
        .replace(/\s+/g, " ")
        .trim();

}

// ============================================================
// 自動產生搜尋 Query
// ============================================================

function generateQueries(
    keyword: string
) {

    const base =
        keyword.trim();

    return [
        `${base} 官方網站 網購`,
        `${base} 官方網站 線上購物`,
        `${base} 網路商店`,
        `${base} 電商`,
        `${base} 線上訂購`,
        `${base} 購物車`,
        `${base} 門市`,
        `${base} 分店`,
        `${base} 品牌 官網`,
    ];
}

// ============================================================
// 搜尋結果評分
// ============================================================

function calculateSearchScore(
    title: string,
    description: string,
    url: string
) {

    const text =
        `${title} ${description} ${url}`
            .toLowerCase();

    let score = 0;

    const foundEcommerce: string[] = [];
    const foundBusiness: string[] = [];
    const foundPhysical: string[] = [];

    // --------------------------------------------------------
    // 電商特徵
    // --------------------------------------------------------

    for (
        const signal
        of ecommerceSignals
    ) {

        if (
            text.includes(
                signal.toLowerCase()
            )
        ) {

            score += 8;

            foundEcommerce.push(
                signal
            );

        }

    }

    // --------------------------------------------------------
    // 商業網站特徵
    // --------------------------------------------------------

    for (
        const signal
        of businessSignals
    ) {

        if (
            text.includes(
                signal.toLowerCase()
            )
        ) {

            score += 5;

            foundBusiness.push(
                signal
            );

        }

    }

    // --------------------------------------------------------
    // 實體店 / POS
    // --------------------------------------------------------

    for (
        const signal
        of physicalSignals
    ) {

        if (
            text.includes(
                signal.toLowerCase()
            )
        ) {

            score += 4;

            foundPhysical.push(
                signal
            );

        }

    }

    // --------------------------------------------------------
    // URL 本身是商業網站
    // --------------------------------------------------------

    const domain =
        getDomain(url);

    if (
        domain &&
        !domain.includes(
            ".blogspot."
        )
    ) {

        score += 5;

    }

    // --------------------------------------------------------
    // 網站名稱 / URL 有 shop
    // --------------------------------------------------------

    if (
        domain.includes("shop") ||
        domain.includes("store")
    ) {

        score += 8;

    }

    // --------------------------------------------------------
    // URL 含 blog / article / news
    // --------------------------------------------------------

    if (
        /blog|article|news|magazine/i.test(
            url
        )
    ) {

        score -= 30;

    }

    // --------------------------------------------------------
    // 標題太像媒體
    // --------------------------------------------------------

    if (
        /新聞|雜誌|專題|報導|百科|評論|心得|討論/i.test(
            title
        )
    ) {

        score -= 35;

    }

    return {

        score,

        ecommerceSignals:
            [
                ...new Set(
                    foundEcommerce
                ),
            ].slice(0, 10),

        businessSignals:
            [
                ...new Set(
                    foundBusiness
                ),
            ].slice(0, 10),

        physicalSignals:
            [
                ...new Set(
                    foundPhysical
                ),
            ].slice(0, 10),

    };

}

// ============================================================
// POST
// ============================================================

export async function POST(
    req: Request
) {

    try {

        const body =
            await req.json();

        const keyword =
            body.keyword?.trim();

        if (!keyword) {

            return NextResponse.json({

                success: false,

                error:
                    "請輸入搜尋關鍵字",

            });

        }

        console.log(
            "🔎 開始搜尋：",
            keyword
        );

        // ====================================================
        // 建立 DDGS
        // ====================================================

        const ddgs =
            new DDGS();

        // ====================================================
        // 自動產生搜尋詞
        // ====================================================

        const queries =
            generateQueries(
                keyword
            );

        console.log(
            "🧠 自動搜尋 Query：",
            queries
        );

        // ====================================================
        // 收集結果
        // ====================================================

        const uniqueMap =
            new Map<
                string,
                any
            >();

        // ====================================================
        // 逐組搜尋
        // ====================================================

        for (
            const query
            of queries
        ) {

            try {

                console.log(
                    "🔍 搜尋：",
                    query
                );

                const searchResults =
                    await ddgs.text({

                        keywords:
                            query,

                        maxResults:
                            12,

                    });

                for (
                    const item
                    of searchResults
                ) {

                    const rawUrl =
                        item.href;

                    if (!rawUrl) {
                        continue;
                    }

                    // ----------------------------------------
                    // 排除網域
                    // ----------------------------------------

                    if (
                        isExcludedDomain(
                            rawUrl
                        )
                    ) {

                        continue;

                    }

                    const title =
                        cleanText(
                            item.title ||
                            ""
                        );

                    const description =
                        cleanText(
                            item.body ||
                            ""
                        );

                    // ----------------------------------------
                    // 排除明顯媒體
                    // ----------------------------------------

                    if (
                        hasExcludedKeyword(
                            title,
                            description,
                            rawUrl
                        )
                    ) {

                        continue;

                    }

                    const url =
                        normalizeUrl(
                            rawUrl
                        );

                    if (!url) {
                        continue;
                    }

                    // ----------------------------------------
                    // 計算商業 / 電商分數
                    // ----------------------------------------

                    const analysis =
                        calculateSearchScore(
                            title,
                            description,
                            url
                        );

                    // ----------------------------------------
                    // 分數太低不要
                    // ----------------------------------------

                    if (
                        analysis.score < 5
                    ) {

                        continue;

                    }

                    // ----------------------------------------
                    // 去重
                    // ----------------------------------------

                    if (
                        uniqueMap.has(
                            url
                        )
                    ) {

                        const existing =
                            uniqueMap.get(
                                url
                            );

                        existing.score +=
                            analysis.score;

                        existing.ecommerceSignals =
                            [
                                ...new Set([
                                    ...existing.ecommerceSignals,
                                    ...analysis.ecommerceSignals,
                                ]),
                            ].slice(
                                0,
                                10
                            );

                        existing.businessSignals =
                            [
                                ...new Set([
                                    ...existing.businessSignals,
                                    ...analysis.businessSignals,
                                ]),
                            ].slice(
                                0,
                                10
                            );

                        existing.physicalSignals =
                            [
                                ...new Set([
                                    ...existing.physicalSignals,
                                    ...analysis.physicalSignals,
                                ]),
                            ].slice(
                                0,
                                10
                            );

                        continue;

                    }

                    // ----------------------------------------
                    // 建立結果
                    // ----------------------------------------

                    uniqueMap.set(
                        url,
                        {

                            title:
                                title ||
                                "未知網站",

                            url,

                            description,

                            score:
                                analysis.score,

                            ecommerceSignals:
                                analysis.ecommerceSignals,

                            businessSignals:
                                analysis.businessSignals,

                            physicalSignals:
                                analysis.physicalSignals,

                        }
                    );

                }

            } catch (error) {

                console.error(
                    "⚠️ Query 搜尋失敗：",
                    query,
                    error
                );

            }

        }

        // ====================================================
        // 排序
        // ====================================================

        const results =
            Array.from(
                uniqueMap.values()
            )
                .sort(
                    (
                        a,
                        b
                    ) =>
                        b.score -
                        a.score
                )
                .slice(
                    0,
                    30
                );

        console.log(
            "🎯 最終網站：",
            results.length
        );

        // ====================================================
        // 回傳
        // ====================================================

        return NextResponse.json({

            success: true,

            keyword,

            queries,

            count:
                results.length,

            results,

        });

    } catch (error) {

        console.error(
            "❌ Search API Error:",
            error
        );

        return NextResponse.json({

            success: false,

            error:
                error instanceof Error
                    ? error.message
                    : "搜尋發生錯誤",

        });

    }

}
